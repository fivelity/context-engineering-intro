# SenseCanvas Environment Configuration
# Copy this file to .env and update with your actual values

# Frontend Configuration
VITE_WEBSOCKET_URL=ws://localhost:8000/ws
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=SenseCanvas
VITE_APP_VERSION=1.0.0

# Backend Configuration
# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Hardware Monitoring
LIBREHARDWARE_DLL_PATH=./LibreHardwareMonitorLib.dll
POLLING_INTERVAL_MS=1000
USE_HARDWARE_ACCELERATION=true
ENABLE_GPU_MONITORING=true

# AI Generation (Google Genkit/Gemini)
GOOGLE_API_KEY=your_google_api_key_here
GENKIT_MODEL=gemini-1.5-pro
AI_RATE_LIMIT_SECONDS=10
AI_CACHE_TIMEOUT=300
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7

# WebSocket Configuration
WS_MAX_CONNECTIONS=100
WS_HEARTBEAT_INTERVAL=30
WS_RECONNECT_INTERVAL=3000
WS_MESSAGE_SIZE_LIMIT=1048576

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Database (for future use)
DATABASE_URL=sqlite:///./sensecanvas.db

# Cache Configuration
ENABLE_CACHE=true
CACHE_TTL=300

# Feature Flags
ENABLE_AI_GENERATION=true
ENABLE_WIDGET_SHARING=true
ENABLE_AUTO_THEME_SWITCH=true
ENABLE_HARDWARE_ALERTS=true

# Development
DEBUG=false
TESTING=false

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# External Services (optional)
SENTRY_DSN=
ANALYTICS_ID=