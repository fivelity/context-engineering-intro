# SenseCanvas Environment Configuration
# Copy this file to .env and fill in your values

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

# Environment mode
ENV=development
DEBUG=true

# Application details
APP_NAME="SenseCanvas"
APP_VERSION="1.0.0"
APP_DESCRIPTION="Futuristic PC Hardware Monitoring Dashboard"

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================

# FastAPI server settings
HOST=0.0.0.0
PORT=8000
WORKERS=1

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Security settings
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================

# Frontend URLs for CORS and redirects
VITE_WEBSOCKET_URL=ws://localhost:8000/ws
VITE_API_BASE_URL=http://localhost:8000

# ==============================================================================
# HARDWARE MONITORING
# ==============================================================================

# LibreHardwareMonitor configuration
LIBREHARDWARE_DLL_PATH=./LibreHardwareMonitorLib.dll
HARDWARE_POLLING_INTERVAL_MS=1000
HARDWARE_ADMIN_REQUIRED=true

# Sensor collection settings
ENABLE_CPU_MONITORING=true
ENABLE_GPU_MONITORING=true
ENABLE_MEMORY_MONITORING=true
ENABLE_STORAGE_MONITORING=true
ENABLE_NETWORK_MONITORING=true
ENABLE_MOTHERBOARD_MONITORING=true

# Alert thresholds
CPU_TEMP_WARNING=75
CPU_TEMP_CRITICAL=85
GPU_TEMP_WARNING=80
GPU_TEMP_CRITICAL=90
MEMORY_USAGE_WARNING=85
MEMORY_USAGE_CRITICAL=95

# ==============================================================================
# WEBSOCKET CONFIGURATION
# ==============================================================================

# Connection management
WS_MAX_CONNECTIONS=100
WS_HEARTBEAT_INTERVAL=30
WS_RECONNECT_DELAY=3
WS_MESSAGE_QUEUE_SIZE=1000

# Subscription types
WS_ENABLE_HARDWARE_METRICS=true
WS_ENABLE_ALERTS=true
WS_ENABLE_SYSTEM_STATUS=true

# ==============================================================================
# AI GENERATION (GOOGLE GENKIT)
# ==============================================================================

# Genkit API configuration
GENKIT_API_KEY=your-genkit-api-key-here
GENKIT_PROJECT_ID=your-gcp-project-id
GENKIT_MODEL=gemini-1.5-pro
GENKIT_REGION=us-central1

# Rate limiting for AI generation
AI_RATE_LIMIT_SECONDS=10
AI_MAX_REQUESTS_PER_HOUR=100
AI_CACHE_TTL_MINUTES=5

# Generation settings
AI_TEMPERATURE=0.7
AI_MAX_OUTPUT_TOKENS=1000
AI_TOP_P=0.9

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# SQLite database (for development)
DATABASE_URL=sqlite:///./sensecanvas.db
DATABASE_ECHO=false

# Connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ==============================================================================
# CACHING
# ==============================================================================

# Cache settings
CACHE_DEFAULT_TTL=300
CACHE_MAX_SIZE=1000
CACHE_ENABLED=true

# Widget configuration cache
WIDGET_CACHE_TTL=600
LAYOUT_CACHE_TTL=1800

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================

# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=json

# Log file settings
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/sensecanvas.log
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_BACKUP_COUNT=5

# Console logging
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_COLORS=true

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================

# Metrics collection
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Health check settings
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# Performance monitoring
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_METRICS=true
SLOW_REQUEST_THRESHOLD_MS=1000

# ==============================================================================
# THEME SYSTEM
# ==============================================================================

# Default theme settings
DEFAULT_THEME=cyberpunk
THEME_CUSTOM_COLORS=true
THEME_ANIMATIONS=true
THEME_EFFECTS=true

# Theme-specific settings
CYBERPUNK_PRIMARY_COLOR=#9d4edd
GAMING_PRIMARY_COLOR=#00ff88
RGB_PRIMARY_COLOR=#ff006e
MINIMAL_PRIMARY_COLOR=#ffffff

# ==============================================================================
# WIDGET CONFIGURATION
# ==============================================================================

# Widget limits and defaults
MAX_WIDGETS_PER_DASHBOARD=50
DEFAULT_WIDGET_SIZE_WIDTH=200
DEFAULT_WIDGET_SIZE_HEIGHT=200
DEFAULT_GRID_CELL_SIZE=20

# Widget export/import
WIDGET_EXPORT_VERSION=1.0
WIDGET_IMPORT_VALIDATION=strict
WIDGET_BACKUP_ENABLED=true

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================

# API security
API_KEY_REQUIRED=false
API_KEY_HEADER=X-API-Key
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW=60

# Content security
UPLOAD_MAX_SIZE=10MB
ALLOWED_FILE_TYPES=json,png,jpg,svg
SANITIZE_INPUTS=true

# ==============================================================================
# DEVELOPMENT SETTINGS
# ==============================================================================

# Development features
DEV_AUTO_RELOAD=true
DEV_MOCK_HARDWARE=false
DEV_AI_MOCK_RESPONSES=false
DEV_ENABLE_CORS=true

# Testing settings
TEST_DATABASE_URL=sqlite:///./test_sensecanvas.db
TEST_MOCK_HARDWARE=true
TEST_TIMEOUT=30

# ==============================================================================
# PRODUCTION SETTINGS
# ==============================================================================

# Production optimizations
PROD_GZIP_ENABLED=true
PROD_STATIC_CACHE_SECONDS=3600
PROD_API_CACHE_SECONDS=60

# Error handling
PROD_HIDE_SERVER_HEADER=true
PROD_DETAILED_ERRORS=false
PROD_ERROR_TRACKING=true

# ==============================================================================
# BACKUP & RECOVERY
# ==============================================================================

# Automatic backups
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# Configuration backup
CONFIG_BACKUP_ON_CHANGE=true
CONFIG_VERSION_HISTORY=10

# ==============================================================================
# INTEGRATION SETTINGS
# ==============================================================================

# External API integrations
EXTERNAL_API_TIMEOUT=30
EXTERNAL_API_RETRIES=3
EXTERNAL_API_RETRY_DELAY=1

# Discord webhook (for alerts)
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_ENABLED=false

# Slack webhook (for alerts)  
SLACK_WEBHOOK_URL=
SLACK_WEBHOOK_ENABLED=false

# ==============================================================================
# EXPERIMENTAL FEATURES
# ==============================================================================

# Feature flags
EXPERIMENTAL_AI_LAYOUTS=false
EXPERIMENTAL_CLOUD_SYNC=false
EXPERIMENTAL_MOBILE_APP=false
EXPERIMENTAL_PLUGIN_SYSTEM=false

# Beta features
BETA_ADVANCED_METRICS=false
BETA_CUSTOM_THEMES=false
BETA_WIDGET_MARKETPLACE=false